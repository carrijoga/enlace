NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://enlace:enlace@localhost:5432/enlace
# Gere um segredo aleatório com pelo menos 32 caracteres. Obrigatório em produção.
BETTER_AUTH_SECRET=
# Assina os links de visualização (ADR-0014). Outro segredo aleatório, 32+ caracteres, diferente
# do anterior. Obrigatório em produção; sem ele, as rotas de compartilhamento respondem 503.
SHARE_LINK_SECRET=
# Recuperação fica indisponível até configurar SMTP completo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Enlace <nao-responda@example.com>
